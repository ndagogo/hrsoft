# systemd unit for bare-metal / VPS deploys (no Docker).
# 1. Install project under /var/www/hrms with a venv
# 2. Copy this file to /etc/systemd/system/hrms.service
# 3. Adjust User/Group/paths, then:
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now hrms

[Unit]
Description=Northbridge HRMS (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/hrms
EnvironmentFile=/var/www/hrms/.env
ExecStart=/var/www/hrms/venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/hrms/media /var/www/hrms/logs /var/www/hrms/staticfiles

[Install]
WantedBy=multi-user.target
