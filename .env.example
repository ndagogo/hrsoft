# =============================================================================
# HRMS - RAILWAY PRODUCTION ENVIRONMENT
# =============================================================================
#
# Deployment platform: Railway
# Application: Django HRMS
# Domain: hr.auxanosoft.com
# Database: Railway PostgreSQL
# Timezone: Africa/Lagos
#
# IMPORTANT:
# 1. Configure these values in Railway -> hrsoft -> Variables.
# 2. Never commit real secrets/passwords to Git.
# 3. Railway PostgreSQL variables are referenced using ${{Postgres.*}}.
# 4. If your PostgreSQL service has a different name, replace "Postgres"
#    with the actual Railway service name.
#
# =============================================================================


# =============================================================================
# DJANGO CORE / PRODUCTION SECURITY
# =============================================================================

# Generate a strong secret with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# IMPORTANT: Replace this placeholder with the generated value in Railway.
DJANGO_SECRET_KEY=<GENERATE-A-NEW-STRONG-DJANGO-SECRET-KEY>

# Production MUST be False.
DJANGO_DEBUG=False

# Your production hostname.
DJANGO_ALLOWED_HOSTS=hr.auxanosoft.com

# Required for Django CSRF protection behind Railway/Cloudflare HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://hr.auxanosoft.com

# Application timezone.
DJANGO_TIME_ZONE=Africa/Lagos

# Production logging level.
DJANGO_LOG_LEVEL=INFO


# =============================================================================
# RAILWAY / REVERSE PROXY / HTTPS
# =============================================================================

# Railway terminates/proxies HTTPS traffic before forwarding to the
# application container.
DJANGO_BEHIND_PROXY=True

# Redirect HTTP requests to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=True

# Secure session and CSRF cookies.
DJANGO_SECURE_COOKIES=True

# HSTS configuration.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Keep False until the domain has been fully verified and you intentionally
# want HSTS preload behaviour.
DJANGO_SECURE_HSTS_PRELOAD=False


# =============================================================================
# MEDIA / FILE UPLOADS
# =============================================================================

# Django serves media files directly.
#
# This is acceptable for the initial Railway deployment.
# For a larger production deployment, move media/uploads to persistent
# object storage such as S3-compatible storage.
DJANGO_SERVE_MEDIA=True

# Maximum size kept in memory before Django streams uploads to disk.
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# Maximum total request body size.
# 512 MB - useful for HR/L&D course uploads.
DATA_UPLOAD_MAX_MEMORY_SIZE=536870912

# Maximum number of submitted form fields.
DATA_UPLOAD_MAX_NUMBER_FIELDS=2000


# =============================================================================
# SESSION SECURITY
# =============================================================================

# 30-minute idle session timeout.
IDLE_SESSION_TIMEOUT_SECONDS=1800


# =============================================================================
# DATABASE - RAILWAY POSTGRESQL
# =============================================================================
#
# Production database is PostgreSQL.
#
# IMPORTANT:
# Do NOT use:
#
#     DB_HOST=localhost
#
# on Railway.
#
# "localhost" refers to the HRMS container itself, not the PostgreSQL service.
#
# Railway provides the PostgreSQL connection information through the Postgres
# service. DATABASE_URL is the preferred connection string.
#
# =============================================================================

DJANGO_DB_ENGINE=postgres

# Preferred Railway PostgreSQL connection.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---------------------------------------------------------------------------
# PostgreSQL native variables
# ---------------------------------------------------------------------------
# These are retained as a fallback for the Django settings / entrypoint.
# Railway supplies these from the PostgreSQL service.
# ---------------------------------------------------------------------------

DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_NAME=${{Postgres.PGDATABASE}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Database connection settings.
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# Allow PostgreSQL a reasonable amount of time to become available during
# Railway deployments/restarts.
DB_WAIT_SECONDS=120


# =============================================================================
# COMPANY / BRANDING
# =============================================================================

COMPANY_NAME=Health Focus Diagnostics Nigeria
COMPANY_CURRENCY=NGN
COMPANY_CURRENCY_SYMBOL=₦


# =============================================================================
# EMAIL / SMTP
# =============================================================================
#
# REQUIRED for:
# - Password reset
# - Email notifications
# - System notifications
# - Administrative alerts
#
# Replace the example values with your real SMTP provider.
#
# =============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

DEFAULT_FROM_EMAIL=noreply@auxanosoft.com
SERVER_EMAIL=noreply@auxanosoft.com

EMAIL_SUBJECT_PREFIX=[HRMS]
EMAIL_TIMEOUT=20


# =============================================================================
# ADMIN / ERROR NOTIFICATIONS
# =============================================================================
#
# Optional.
#
# Format:
# DJANGO_ADMINS=Name:email@example.com,Another Name:another@example.com
#
# Example:
# DJANGO_ADMINS=IT Admin:it@healthfocusdiagnostics.com
#
# =============================================================================

# DJANGO_ADMINS=IT Admin:it@healthfocusdiagnostics.com


# =============================================================================
# OPTIONAL SMS / WHATSAPP INTEGRATIONS
# =============================================================================

SMS_API_URL=
WHATSAPP_API_URL=


# =============================================================================
# BIOMETRIC INTEGRATION
# =============================================================================
#
# IMPORTANT:
# Railway cannot directly reach a biometric device on your private LAN,
# e.g. 192.168.1.201.
#
# These values are retained for the biometric integration configuration,
# but the Railway-hosted application will NOT be able to directly access
# 192.168.1.201 unless a secure connectivity/agent architecture is provided.
#
# =============================================================================

BIOMETRIC_POLL_INTERVAL=60

# IMPORTANT: Replace with a strong random secret.
BIOMETRIC_WEBHOOK_SECRET=<GENERATE-A-STRONG-BIOMETRIC-WEBHOOK-SECRET>

ZK_TIMEOUT_SECONDS=10

# Skip ICMP ping before TCP connection.
# Recommended because ICMP is frequently blocked.
ZK_OMIT_PING=True

# Local ZKTeco device.
ZK_DEFAULT_IP=192.168.1.201
ZK_DEFAULT_PORT=4370


# =============================================================================
# GUNICORN / RAILWAY APPLICATION SERVER
# =============================================================================
#
# Railway provides the PORT environment variable to the application.
#
# Your Gunicorn configuration/start command should listen on:
#
#     0.0.0.0:$PORT
#
# Do NOT hard-code port 80 for Railway.
#
# HTTP_PORT is retained only as an application configuration fallback.
# =============================================================================

HTTP_PORT=8000

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
