# =============================================================================
# HRMS environment template
# Copy to .env and fill in real values before running or deploying.
# =============================================================================

# --- Core Django ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=hr.auxanosoft.com
# Production example:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=hrms.example.com,www.hrms.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hrms.example.com,https://www.hrms.example.com

DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Lagos
DJANGO_LOG_LEVEL=INFO

# Behind nginx / load balancer (True in Docker Compose)
DJANGO_BEHIND_PROXY=False
# Require HTTPS redirects + HSTS (True only when TLS is terminated)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# Serve /media via Django (False when nginx serves media, as in docker-compose)
DJANGO_SERVE_MEDIA=True

# Upload limits (bytes). Raise for large L&D video courses (default ~512MB body).
# FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
# DATA_UPLOAD_MAX_MEMORY_SIZE=536870912

# Optional: error-email recipients as Name:email pairs
# DJANGO_ADMINS=Ops Team:ops@example.com,HR Admin:hr@example.com

# Idle session timeout in seconds (default 30 minutes)
IDLE_SESSION_TIMEOUT_SECONDS=1800

# --- Database ---
# Local quick start:
DJANGO_DB_ENGINE=sqlite
# Production / Docker:
# DJANGO_DB_ENGINE=postgres
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=change-me-strong-db-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10

# --- Company branding ---
COMPANY_NAME=Health Focus Diagnostics Nigeria
COMPANY_CURRENCY=NGN
COMPANY_CURRENCY_SYMBOL=₦

# --- Email (required for password reset / notifications in production) ---
# Local DEBUG uses an on-disk mailbox backend automatically.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com
EMAIL_SUBJECT_PREFIX=[HRMS]
EMAIL_TIMEOUT=20

# Optional notification integrations
SMS_API_URL=
WHATSAPP_API_URL=

# --- Biometric integration ---
BIOMETRIC_POLL_INTERVAL=60
BIOMETRIC_WEBHOOK_SECRET=change-this-too
ZK_TIMEOUT_SECONDS=10
# Skip ICMP ping before TCP connect (recommended; ping is often blocked)
ZK_OMIT_PING=True
ZK_DEFAULT_IP=192.168.1.201
ZK_DEFAULT_PORT=4370

# --- Gunicorn / Docker ---
HTTP_PORT=80
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
