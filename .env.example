# Copy this file to .env and fill in real values for your environment.
# config/settings.py reads these via os.environ — load them with
# `python-dotenv` (see manage.py / wsgi.py if you wire it in) or export
# them in your shell / process manager before running Django.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL by default)
# DJANGO_DB_ENGINE=postgres
DJANGO_DB_ENGINE=sqlite
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=hrms_password
DB_HOST=localhost
DB_PORT=5432

# Set to "sqlite" instead for a zero-setup local trial run:
# DJANGO_DB_ENGINE=sqlite

DJANGO_TIME_ZONE=Africa/Lagos

COMPANY_NAME=Northbridge Industries
COMPANY_CURRENCY=NGN
COMPANY_CURRENCY_SYMBOL=₦

# Biometric integration
BIOMETRIC_POLL_INTERVAL=60
BIOMETRIC_WEBHOOK_SECRET=change-this-too
